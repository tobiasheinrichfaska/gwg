{
  "name": "gwg",
  "private": true,
  "version": "0.1.0",
  "description": "Money-laundering-act (GwG) maintenance for tax advisory firms: risk classes, identification status, review deadlines, sanctions screening, yearly audit, deletion deadlines — as one offline HTML file.",
  "license": "AGPL-3.0-only",
  "author": "Tobias Heinrich",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --port 5178 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5178 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "local-vault": "github:tobiasheinrichfaska/local-vault#v0.1.0",
    "rad-navi": "github:tobiasheinrichfaska/rad-navi#v0.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.0.12",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.12"
  }
}
